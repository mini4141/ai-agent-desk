# Copy to .env (gitignored). Local defaults use mock providers and make no AWS calls.
# LLM_PROVIDER: mock | bedrock.  SPEECH_PROVIDER: browser | aws.  EMBEDDING_PROVIDER: mock | bedrock.
LLM_PROVIDER=mock
SPEECH_PROVIDER=browser
EMBEDDING_PROVIDER=mock
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
JWT_SECRET=dev-only-change-me
SEED_PASSWORD=agentdesk-demo
COMPANY_BACKEND_URL=http://company-backend:4567
TOOL_HMAC_SECRET=dev-tool-secret
HELP_CENTER_URL=http://localhost:3001
MOCK_FIRST_TOKEN_DELAY_MS=30
MOCK_TOKEN_DELAY_MS=6
AR_ENC_PRIMARY_KEY=dev-primary-key-0123456789abcdef
AR_ENC_DETERMINISTIC_KEY=dev-determ-key-0123456789abcdef
AR_ENC_KEY_DERIVATION_SALT=dev-salt-0123456789abcdef
LOAD_TEST_TOKEN=local-load-test
